<style>
  .panel-root {
    flex-direction: column;
    width: 580px;
    background-color: #0b131e;
    border-color: #1e3a5f;
    border-width: 2px;
    border-radius: 14px;
    padding: 24px;
  }

  .eyebrow {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
  }

  .panel-title {
    color: #ffffff;
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .tolerance-card {
    flex-direction: column;
    background-color: #132235;
    border-color: #2b4566;
    border-width: 1px;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 16px;
  }

  .param-row {
    color: #cbd5e1;
    font-size: 15px;
    margin-bottom: 4px;
  }

  .tolerance-limits {
    color: #f59e0b;
    font-size: 15px;
    font-weight: 600;
  }

  .result-banner {
    background-color: #1a2a3e;
    border-color: #3b82f6;
    border-width: 1px;
    border-radius: 6px;
    padding: 12px;
    color: #f8fafc;
    font-size: 15px;
    margin-bottom: 18px;
  }

  .button-row {
    flex-direction: row;
    gap: 10px;
  }

  .action-btn {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
  }
</style>
<Panel class="panel-root">
  <div class="eyebrow">QUALITY ASSURANCE | DIMENSIONAL GAUGE</div>
  <div class="panel-title">Seating Depth Clearance</div>
  <div class="tolerance-card">
    <div class="param-row">Nominal Target: 24.00 mm</div>
    <div class="param-row">Tolerance: +/- 0.10 mm</div>
    <div class="tolerance-limits">Acceptable Range: [23.90 mm to 24.10 mm]</div>
  </div>
  <div id="vr-inspection-feedback" class="result-banner">
    Ready for measurement. Select simulated reading below:
  </div>
  <div class="button-row">
    <Button id="vr-btn-pass-2402" class="action-btn">
      <ButtonLabel>24.02 mm (PASS)</ButtonLabel>
    </Button>
    <Button id="vr-btn-fail-2418" class="action-btn">
      <ButtonLabel>24.18 mm (FAIL)</ButtonLabel>
    </Button>
    <Button id="vr-btn-pass-2395" class="action-btn">
      <ButtonLabel>23.95 mm (PASS)</ButtonLabel>
    </Button>
  </div>
</Panel>
