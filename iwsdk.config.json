{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "vr",
      "offer": "always",
      "features": {
        "handTracking": true,
        "hitTest": true,
        "planeDetection": true,
        "anchors": true,
        "depthSensing": {
          "required": false,
          "usage": "gpu-optimized",
          "format": "float32"
        }
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "fov": 70,
      "near": 0.001,
      "far": 200,
      "camera": {
        "position": [
          0,
          1.35,
          0.3
        ],
        "lookAt": [
          0,
          1.05,
          -1.1
        ]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": true,
      "physics": false,
      "sceneUnderstanding": true,
      "environmentRaycast": true,
      "spatialUI": {
        "kit": "horizon",
        "preferredColorScheme": "dark"
      }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3"
    }
  }
}
